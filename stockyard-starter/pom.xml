<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>stockyard</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>stockyard-starter</artifactId>
  <name>stockyard-starter</name>
  <description>Spring Boot 自动装配：注册库存位存储、预占存储与幂等扣减 Bean，按 X-Tenant-Id 解析租户，提供 /stockyard/reservations 与 /stockyard/positions 端点。</description>

  <dependencies>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>stockyard-core</artifactId>
    </dependency>
    <!--
      starter 是唯一需要「开箱即用默认 Bean」的地方，因此显式依赖内存存储实现。
      生产用户可以通过自己注册 StockPositionStore / ReservationStore / DeductionStore Bean
      覆盖（@ConditionalOnMissingBean），此时本依赖只贡献类、不贡献 Bean。
    -->
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>stockyard-store</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <properties>
    <jacoco.report.skip>false</jacoco.report.skip>
  </properties>
</project>
